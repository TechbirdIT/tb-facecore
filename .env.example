# AI service auth secret — MUST match Face Recognition Settings > Embedding Service
# Secret in the Frappe face_attendance app. install.sh generates one into .env.
AI_SERVICE_SECRET=change-me

# ai_service -> deepface sidecar base URL (the fork exposes API on host port 5005)
AI_SERVICE_DEEPFACE_URL=http://localhost:5005/api/v1

# The deepface sidecar's own config lives in vendor/deepface/docker/.env
# (created from vendor/deepface/docker/.env.example by its ./deploy.sh, or copy manually).
